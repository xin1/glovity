{
  "name": "03 C1 通道映射验证",
  "matrix_ids": [
    "C1"
  ],
  "description": "逐通道下发不同的 F_PRE 与 DRV1_LVL（CH0=150 Hz/40 → CH7=185 Hz/96），每路都自动回读 0x1C 与 0x18 确认参数确实落到了目标通道（验证 TCA9548A 选通与通道号的对应关系），再播放 0.6 s 让人工确认『振动的是哪一个通道、现象是否与通道号一一对应』。人工确认结论会收进报告的『关键实测值』表。所有通道的频率/幅度都不同，便于用振感或示波器区分。 【已适配本板：实际贴装 CH4~CH7（掩码 0xF0）】",
  "channels": [
    4,
    5,
    6,
    7
  ],
  "steps": [
    {
      "op": "log",
      "text": "C1 通道映射验证开始：逐通道播不同频率/幅度，人工确认现象与通道号一一对应"
    },
    {
      "op": "bus_probe",
      "bus_sel": 0
    },
    {
      "op": "ch_probe_all",
      "expect_chipid": 9024,
      "note": "先确认在线通道与 CHIPID（0x2340）"
    },
    {
      "op": "log",
      "text": "每路：下发 CONT 参数（不同 F_PRE 与 DRV1_LVL）→ 回读核对 0x1C/0x18 → 播放 → 人工确认 → 停止"
    },
    {
      "op": "set_profile",
      "chan": 4,
      "params": {
        "mode": 2,
        "track_en": 0,
        "brk_en": 1,
        "drv1_lvl": 40,
        "drv2_lvl": 40,
        "f_pre": 160,
        "drv_width": 106,
        "en_f0_det": 0,
        "wait_num": 6,
        "brk_gain": 8,
        "brk_time": 8,
        "sin_mode": 0,
        "edge_fre": 0,
        "drv1_time": 4,
        "drv2_time": 6,
        "track_margin": 17
      },
      "note": "CH0：F_PRE=160 → F0≈150.0 Hz，DRV1_LVL=40"
    },
    {
      "op": "set_mode",
      "chan": 4,
      "mode": "CONT"
    },
    {
      "op": "assert_read",
      "chan": 4,
      "addr": "0x1C",
      "mask": 127,
      "expect": 40,
      "note": "回读 CH0 的 DRV1_LVL（mask 0x7F 保住 TRACK_EN）；同时验证 TCA 选通切到了 CH0"
    },
    {
      "op": "assert_read",
      "chan": 4,
      "addr": "0x18",
      "expect": 160,
      "note": "回读 CH0 的 F_PRE（0x18）"
    },
    {
      "op": "play",
      "chan": 4,
      "timeout_ms": 3000
    },
    {
      "op": "wait",
      "ms": 600
    },
    {
      "op": "prompt",
      "message": "CH0（150 Hz，幅度 40）：请确认是否只有本通道的马达在振动，且振感明显区别于 CH0。填写「正确/错误 + 现象」",
      "field": "ch0_映射确认",
      "unit": ""
    },
    {
      "op": "stop",
